@model Inventory.Web.Models.Product
@{ ViewData["Title"] = "Product details"; }
<div class="form-shell"><p class="eyebrow">Product details</p><h1>@Model.Name</h1><p class="lead">@(Model.Description ?? "No description provided.")</p><dl class="row mt-4"><dt class="col-sm-4">Price</dt><dd class="col-sm-8">@Model.Price.ToString("C")</dd><dt class="col-sm-4">Stock quantity</dt><dd class="col-sm-8">@Model.StockQuantity</dd><dt class="col-sm-4">Last updated</dt><dd class="col-sm-8">@Model.UpdatedAt.ToLocalTime().ToString("g")</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> <a asp-action="Index" class="btn btn-link">Back to products</a></div>
