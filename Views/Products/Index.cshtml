@model IEnumerable<Inventory.Web.Models.Product>
@{
    ViewData["Title"] = "Products";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="eyebrow mb-1">Inventory</p>
        <h1 class="mb-1">Products</h1>
        <p class="text-muted mb-0">A small, practical product catalogue.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add product</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-sm-8 col-md-6">
        <label for="search" class="visually-hidden">Search products</label>
        <input id="search" name="search" value="@search" class="form-control" placeholder="Search by name or description" />
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">Search</button></div>
    @if (!string.IsNullOrWhiteSpace(search)) { <div class="col-auto"><a asp-action="Index" class="btn btn-link">Clear</a></div> }
</form>

@if (TempData["Message"] is string message) { <div class="alert alert-success">@message</div> }

@if (!Model.Any())
{
    <div class="empty-state"><h2>No products found</h2><p class="text-muted">Try another search or add the first product.</p></div>
}
else
{
    <div class="table-responsive card border-0 shadow-sm">
        <table class="table align-middle mb-0">
            <thead><tr><th>Name</th><th>Description</th><th>Price</th><th>Stock</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td class="fw-semibold">@product.Name</td>
                    <td class="text-muted">@(product.Description ?? "—")</td>
                    <td>@product.Price.ToString("C")</td>
                    <td><span class="badge @(product.StockQuantity == 0 ? "text-bg-danger" : product.StockQuantity < 10 ? "text-bg-warning" : "text-bg-success")">@product.StockQuantity</span></td>
                    <td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@product.Id">View</a> · <a asp-action="Edit" asp-route-id="@product.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@product.Id" class="text-danger">Delete</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
